# --- Public origin (sitemap, robots, canonical URLs) ---
# Defaults to https://atshero.app in code; set it only if the public origin changes.
# NEXT_PUBLIC_SITE_URL=https://atshero.app

# --- Analytics (Google Tag Manager, public pages only, after the visitor accepts) ---
# Empty = no banner and no script. Set the container ID (GTM-XXXXXXX) in Vercel in the same release
# as the Privacy page update (AGENTS.md rule 11). Never used in /app.
# Has no effect until PRIVACY_LISTS_CONSENT is true in lib/consent.ts (the Privacy page lists the cookies).
NEXT_PUBLIC_GTM_ID=

# --- Postgres (Drizzle) ---
# Local dev: docker compose up -d  (apps/web/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/atshero
# Production (RDS): postgresql://atshero_app:<pwd>@<endpoint>:5432/atshero
# Preview (same instance, own DB and user): postgresql://atshero_dev_app:<pwd>@<endpoint>:5432/atshero_dev
# No ?sslmode=... in these URLs: TLS and the pinned RDS CA live in db/index.ts.
# Migrations are applied MANUALLY (npm run db:migrate) after a snapshot — never at build time.
# `npm run db:push` is local-only; never point it at RDS.

# --- Clerk (Clerk Dashboard → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk's server-side telemetry off too (the browser side is off in app/layout.tsx). Set it in Vercel.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# --- Cron (Vercel Cron sends this as `Authorization: Bearer <secret>`) ---
CRON_SECRET=

# --- Python AI service (apps/ai) ---
# Base URL of the FastAPI service (Tier 2 detectors: /score, /extract, /job-fit, /format, /region).
NEXT_PUBLIC_AI_URL=http://localhost:8000
# ATS read check in the export modal (needs apps/ai /parse-check reachable). Off until apps/ai is deployed.
NEXT_PUBLIC_ATS_CHECK_ENABLED=false

# --- Tier 3 AI rewriting (Vercel AI SDK, multi-provider) ---
# Kill-switch: /api/rewrite returns 503 unless this is exactly "true".
AI_REWRITE_ENABLED=false
AI_REWRITE_DAILY_LIMIT=5
# Provider selection + optional model override (see lib/ai/rewriter.ts).
AI_PROVIDER=openai
# AI_MODEL=
# Set the API key for the provider you chose above (real keys go in .env.local, never committed):
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Billing (Paddle) — code is behind this flag; UI ignores it while false ---
NEXT_PUBLIC_BILLING_ENABLED=false
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=

# --- Feedback link target (optional; falls back to a mailto:) ---
# NEXT_PUBLIC_FEEDBACK_URL=
