# --- Convex (written automatically by `npx convex dev`) ---
NEXT_PUBLIC_CONVEX_URL=

# --- Vercel Production only (NOT in .env.local) ---
# CONVEX_DEPLOY_KEY=   # Convex Dashboard → Generate Production Deploy Key
# Used by: npx convex deploy --cmd 'npm run build'

# --- Clerk (Clerk Dashboard → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Note: CLERK_JWT_ISSUER_DOMAIN is a Convex env var (not Next.js).
# Set it with: npx convex env set CLERK_JWT_ISSUER_DOMAIN https://YOUR-APP.clerk.accounts.dev
# auth.config.ts also falls back to the current ATS Hero Clerk Frontend API URL.

# --- Python AI service (apps/ai) ---
# Base URL of the FastAPI service (Tier 2 detectors: /score, /extract, /job-fit, /format, /region).
NEXT_PUBLIC_AI_URL=http://localhost:8000

# --- Tier 3 AI rewriting (Vercel AI SDK, multi-provider) ---
# Provider selection + optional model override (see lib/ai/rewriter.ts).
AI_PROVIDER=openai
# AI_MODEL=
# Set the API key for the provider you chose above (real keys go in .env.local, never committed):
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
